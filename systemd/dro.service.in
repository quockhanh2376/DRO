[Unit]
Description=DRO DNS Route Optimizer (@DRO_SERVICE_NAME@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dro
Group=dro
WorkingDirectory=@DRO_INSTALL_DIR@
EnvironmentFile=@DRO_ENV_FILE@
Environment=DRO_DATABASE_URL=@DRO_DATABASE_URL@
ExecStartPre=@DRO_INSTALL_DIR@/.venv/bin/alembic -c @DRO_INSTALL_DIR@/alembic.ini upgrade head
ExecStart=@DRO_INSTALL_DIR@/.venv/bin/uvicorn app.api.application:app --host 127.0.0.1 --port @DRO_LISTEN_PORT@ --no-access-log
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/dro /var/log/dro
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=append:@DRO_LOG_FILE@
SyslogIdentifier=@DRO_SERVICE_NAME@

[Install]
WantedBy=multi-user.target
